# Base de datos PostgreSQL (Neon.tech en nube o postgres://... local)
DATABASE_URL=postgres://usuario:password@host/nombre_db?sslmode=require

# Secreto criptográfico para JWT (mínimo 32 caracteres)
JWT_SECRET=tu_secreto_super_seguro_de_mas_de_32_caracteres

# Puerto interno del servidor
PORT=3001

# URL del Frontend (Vercel o localhost) para CORS
FRONTEND_URL=https://tu-app.vercel.app

# Credencial de Google OAuth (Web Application Client ID)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Entorno: development o production
ENVIRONMENT=production
